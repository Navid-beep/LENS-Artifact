plugin -i slang 
plugin -i YosysPass/bin/MiterStutteringPass.so 
plugin -i YosysPass/bin/stuttering.so
plugin -i YosysPass/bin/RegMemInitPass.so
plugin -i YosysPass/bin/show_regs_mems.so

read_slang --single-unit --allow-use-before-declare --allow-merging-ansi-ports \
           --best-effort-hierarchy --error-limit=0  ../src/simpleooo/memd.v ../src/simpleooo/cpu_ooo.v ../src/simpleooo/rf.v ../src/simpleooo/param.v ../src/simpleooo/decode.v ../src/simpleooo/rob_nda.v ../src/simpleooo/execute.v ../src/simpleooo/memi.v ../src/simpleooo/renameTable.v #read_verilog -sv -formal   ../src/simpleooo/memd.v ../src/simpleooo/cpu_ooo.v ../src/simpleooo/rf.v ../src/simpleooo/param.v ../src/simpleooo/decode.v ../src/simpleooo/rob_nda.v ../src/simpleooo/execute.v ../src/simpleooo/memi.v ../src/simpleooo/renameTable.v  
hierarchy -top cpu_ooo -keep_positionals
proc -norom -noopt
write_json results/UASC_Houdini_SOOO_I_rIC3_regs/Hierarchy/duv_structure.json
