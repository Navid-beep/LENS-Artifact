plugin -i slang 
plugin -i YosysPass/bin/MiterStutteringPass.so 
plugin -i YosysPass/bin/stuttering.so
plugin -i YosysPass/bin/RegMemInitPass.so
plugin -i YosysPass/bin/show_regs_mems.so

read_slang --single-unit --allow-use-before-declare --allow-merging-ansi-ports \
           --best-effort-hierarchy --error-limit=0  ../src/simpleooo_cache/memd.v ../src/simpleooo_cache/cpu_ooo.v ../src/simpleooo_cache/rf.v ../src/simpleooo_cache/param.v ../src/simpleooo_cache/decode.v ../src/simpleooo_cache/rob_nda.v ../src/simpleooo_cache/execute.v ../src/simpleooo_cache/memi.v ../src/simpleooo_cache/renameTable.v #read_verilog -sv -formal   ../src/simpleooo_cache/memd.v ../src/simpleooo_cache/cpu_ooo.v ../src/simpleooo_cache/rf.v ../src/simpleooo_cache/param.v ../src/simpleooo_cache/decode.v ../src/simpleooo_cache/rob_nda.v ../src/simpleooo_cache/execute.v ../src/simpleooo_cache/memi.v ../src/simpleooo_cache/renameTable.v  
hierarchy -top cpu_ooo -keep_positionals
proc -norom -noopt
write_json results/UASC_Houdini_SOOO_Cache_IBM_smtbmc/Hierarchy/duv_structure.json
