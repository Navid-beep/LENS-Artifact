plugin -i slang 
plugin -i YosysPass/bin/MiterStutteringPass.so 
plugin -i YosysPass/bin/stuttering.so
plugin -i YosysPass/bin/RegMemInitPass.so
plugin -i YosysPass/bin/show_regs_mems.so

read_slang -Wno-duplicate-definition --allow-use-before-declare  ../src/simpleooo/memd.v ../src/simpleooo/cpu_ooo.v ../src/simpleooo/rf.v ../src/simpleooo/param.v ../src/simpleooo/decode.v ../src/simpleooo/rob_nda.v ../src/simpleooo/execute.v ../src/simpleooo/memi.v ../src/simpleooo/renameTable.v  
hierarchy -top cpu_ooo -keep_positionals
proc -norom -noopt
reg_mem_init cpu_ooo results/UASC_SOOO_IB_Baseline/Hierarchy
write_verilog results/UASC_SOOO_IB_Baseline/Hierarchy/duv_structure.v
