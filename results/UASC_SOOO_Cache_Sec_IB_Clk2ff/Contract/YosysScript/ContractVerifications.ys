plugin -i slang 
plugin -i YosysPass/bin/Stalling.so 
plugin -i YosysPass/bin/RegMemInitPass.so


#read_verilog -sv  ../src/simpleooo_cache_secure/memd.v ../src/simpleooo_cache_secure/cpu_ooo.v ../src/simpleooo_cache_secure/rf.v ../src/simpleooo_cache_secure/param.v ../src/simpleooo_cache_secure/decode.v ../src/simpleooo_cache_secure/rob_nda.v ../src/simpleooo_cache_secure/execute.v ../src/simpleooo_cache_secure/memi.v ../src/simpleooo_cache_secure/renameTable.v  
read_slang --allow-use-before-declare  ../src/simpleooo_cache_secure/memd.v ../src/simpleooo_cache_secure/cpu_ooo.v ../src/simpleooo_cache_secure/rf.v ../src/simpleooo_cache_secure/param.v ../src/simpleooo_cache_secure/decode.v ../src/simpleooo_cache_secure/rob_nda.v ../src/simpleooo_cache_secure/execute.v ../src/simpleooo_cache_secure/memi.v ../src/simpleooo_cache_secure/renameTable.v  
hierarchy -top cpu_ooo
proc -norom -noopt
flatten cpu_ooo 
bwmuxmap
write_verilog results/UASC_SOOO_Cache_Sec_IB_Clk2ff/Contract/Verilog/single_design_verilog.v 
miter -equiv cpu_ooo cpu_ooo miter_cpu_ooo
cd miter_cpu_ooo
cd ..

select -set strip miter_cpu_ooo/i:* miter_cpu_ooo/w:in_clk %d
setattr -set keep 1 @strip
delete -port @strip
setundef -undriven -zero @strip      # all of them to 0

stalling cpu_ooo clk stall_signal
hierarchy -top miter_cpu_ooo
proc -norom -noopt
flatten #-nocleanup miter_cpu_ooo 
async2sync
dffunmap
reg_mem_init miter_cpu_ooo .
bwmuxmap
write_verilog results/UASC_SOOO_Cache_Sec_IB_Clk2ff/Contract/Verilog/contractVerification_verilog.v 